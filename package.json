{
  "name": "zawedni-3d-20min",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && npm run typecheck && vite build",
    "preview": "vite preview --port 4320 --host 127.0.0.1",
    "check": "node scripts/check-provenance.mjs && node --import tsx scripts/check-content-current.mjs",
    "verify": "QA_DOM_ONLY=1 QA_CAPTURE=0 node --import tsx scripts/verify-classic.mjs",
    "test": "node --import tsx --test tests/*.test.ts && python3 -B tests/test_server.py",
    "typecheck": "tsc --noEmit",
    "verify:media": "node scripts/verify-media.mjs",
    "notes": "node --import tsx scripts/export-notes.mjs",
    "verify:launcher": "node scripts/test-launcher.mjs",
    "verify:slides": "node --import tsx scripts/verify-slide-chrome.mjs",
    "verify:animations": "node scripts/verify-slide-polish.mjs",
    "verify:lines": "node scripts/verify-chapter3-lines.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "description": "A local-first 3D presentation of the ZAWEDNI web and mobile platform and its DevSecOps delivery workflow.",
  "engines": {
    "node": ">=20.20.0"
  }
}
